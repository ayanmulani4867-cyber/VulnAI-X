# =================================================================
# VulnAI X — Application Environment Configuration Template
# Copy this file to .env before starting the platform
# =================================================================

APP_NAME=VulnAI X
APP_ENV=development
DEBUG=false

# Security & Authentication
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite development mode:
DATABASE_URL=sqlite:///./vulnai_x.db
# Cloud PostgreSQL mode (e.g. Neon, Supabase, or AWS RDS):
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/vulnaix_db?sslmode=require

# Research Safety & Scope Controls
EMERGENCY_STOP=false
# Set to true ONLY in isolated local mock testing labs. Blocks 127.0.0.1, 10.0.0.0/8, 169.254.169.254 by default.
ALLOW_PRIVATE_LAB_TARGETS=false
MAX_REDIRECT_HOPS=5
REQUEST_TIMEOUT_SECONDS=15
MAX_UPLOAD_SIZE_MB=50

# Background Worker & Limits
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_SECONDS=900
MAX_RETRY_ATTEMPTS=3
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_INTERVAL_SECONDS=10

# Email Alerts (SMTP)
# Fill these in to receive email notifications when critical findings are discovered
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=vulnai-alerts@example.com
SMTP_TLS=true
NOTIFICATION_EMAIL_TO=researcher@example.com

# Frontend API URL
VITE_API_URL=http://localhost:8000
